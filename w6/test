def rehearsal_row(protocol_id: str, status: str) -> dict:
    return {
        "protocol_id": protocol_id,
        "status": status,
        "release_id": "active-release",
        "private_fields_absent_from_backend_command": True,
        "isolated_from_chat": True,
    }


def test_build_report_keeps_success_claims_scoped(tmp_path: Path):
    make_fixture(tmp_path)
    report = build_report(tmp_path)
    assert report["week7_reporting_allocation"]["task_ids"] == [
        "QA-02",
        "QA-03",
        "QA-05",
        "CHAT-10",
    ]
    assert report["success_demo"]["r0_qrel_pool"]["judged_count"] == 0
    assert report["success_claim"]["local_technical_demo_passed"] is True
    assert report["success_claim"]["live_answer_quality_measured"] is False
    assert report["success_claim"]["human_teaching_ratings_collected"] is False


def test_build_report_rejects_private_boundary_regression(tmp_path: Path):
    make_fixture(tmp_path)
    path = tmp_path / "evidence/sciq/technical-rehearsal.json"
    data = json.loads(path.read_text(encoding="utf-8"))
    data["results"][0]["private_fields_absent_from_backend_command"] = False
    write_json(path, data)
    with pytest.raises(ValueError, match="private-field boundary"):
        build_report(tmp_path)


def test_write_outputs_creates_week07_files(tmp_path: Path):
    make_fixture(tmp_path)
    report = build_report(tmp_path)
    output = write_outputs(report, tmp_path)
    assert output["evidence"] == "evidence/week07/chong_zhang/week07_success_demo.json"
    assert output["summary"] == "docs/week07/Chong_Zhang/Week07_Plan_Summary.md"
    assert (tmp_path / output["evidence"]).exists()
    summary = (tmp_path / output["summary"]).read_text(encoding="utf-8")
    assert "本周任务分配" in summary
    assert "does not claim live answer correctness" in summary
