def write_outputs(report: dict[str, Any], root: Path = ROOT) -> dict[str, str]:
    evidence_path = root / "evidence/week07/chong_zhang/week07_success_demo.json"
    summary_path = root / "docs/week07/Chong_Zhang/Week07_Plan_Summary.md"
    atomic_json(evidence_path, report)
    summary_path.parent.mkdir(parents=True, exist_ok=True)
    summary_path.write_text(render_markdown(report), encoding="utf-8", newline="\n")
    return {
        "evidence": evidence_path.relative_to(root).as_posix(),
        "summary": summary_path.relative_to(root).as_posix(),
        "report_hash": report["report_hash"],
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=ROOT)
    parser.add_argument("--check-only", action="store_true")
    args = parser.parse_args(argv)
    root = args.root.resolve()
    report = build_report(root)
    output = {"status": "passed", "report_hash": report["report_hash"]}
    if not args.check_only:
        output |= write_outputs(report, root)
    print(json.dumps(output, ensure_ascii=False, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
