ROOT = Path(__file__).resolve().parents[2]
OWNER = "Chong Zhang"
COURSE_WEEK = 7
TOTAL_COURSE_WEEKS = 13
EXPECTED_WEEK7_TASKS = ("QA-02", "QA-03", "QA-05", "CHAT-10")
WEEK7_CARRY_FORWARD = ("QA-04", "QA-07", "QA-10")
PUBLIC_PRIVATE_EVIDENCE = (
    "evaluation/datasets/sciq_openqa.py",
    "evaluation/runner.py",
    "evaluation/BACKEND_PROTOCOL.md",
)


def _require(condition: bool, message: str) -> None:
    if not condition:
        raise ValueError(message)


def _read_xml_test_count(path: Path) -> int:
    root = ET.parse(path).getroot()
    if "tests" in root.attrib:
        return int(root.attrib["tests"])
    suite = root.find("testsuite")
    _require(suite is not None and "tests" in suite.attrib, "pytest.xml lacks a test count")
    return int(suite.attrib["tests"])


def _task_map(root: Path) -> dict[str, dict[str, Any]]:
    tasks = read_json(root / "docs/execution/tasks.json")["tasks"]
    return {task["task_id"]: task for task in tasks}


def _chong_schedule(root: Path) -> list[dict[str, Any]]:
    plan = read_json(root / "docs/execution/reporting_plan.json")
    packages = [
        package
        for package in plan["weekly_work_packages"]
        if package.get("accountable_owner") == OWNER
    ]
    packages.sort(key=lambda value: value["course_week"])
    _require(packages, "No Chong Zhang schedule rows were found")
    if packages[-1]["course_week"] < TOTAL_COURSE_WEEKS:
        packages.append(
            {
                "course_week": TOTAL_COURSE_WEEKS,
                "project_week": TOTAL_COURSE_WEEKS - 2,
                "task_ids": ["QA-07", "QA-10"],
                "work": (
                    "Optional follow-up only: run live answer or independent human-review work "
                    "only after those external inputs are actually available."
                ),
                "deliverables": ["evidence/research/", "docs/research/"],
                "acceptance": "Do not convert missing live/human evidence into a pass.",
                "reporting_view_only": True,
            }
        )
    return packages


def _week7_package(schedule: list[dict[str, Any]]) -> dict[str, Any]:
    for package in schedule:
        if package["course_week"] == COURSE_WEEK:
            return package
    raise ValueError("Week 7 schedule row is missing")


def _software_gate(root: Path) -> dict[str, Any]:
    gate = read_json(root / "evidence/final/software_gate.json")
    _require(gate["status"] == "passed", "The public software gate is not passed")
    _require(gate["source_files_unchanged"], "The gate reports source drift during execution")
    _require(
        all(check["exit_code"] == 0 for check in gate["checks"]),
        "One or more software gate commands failed",
    )
    pytest_count = _read_xml_test_count(root / "evidence/final/pytest.xml")
    return {
        "status": gate["status"],
        "executed_at": gate["executed_at"],
        "mode": gate["mode"],
        "check_count": len(gate["checks"]),
        "python_test_count": pytest_count,
        "source_files_unchanged": gate["source_files_unchanged"],
        "separate_evidence_required": gate["separate_evidence_required"],
    }


def _sciq_rehearsal(root: Path) -> dict[str, Any]:
    rehearsal = read_json(root / "evidence/sciq/technical-rehearsal.json")
    results = rehearsal["results"]
    _require(rehearsal["status"] == "completed", "SciQ technical rehearsal did not complete")
    _require(rehearsal["model_mode"] == "mock", "Week 7 demo expects explicit mock answering")
    _require(rehearsal["scheduled_count"] == 4 == len(results), "Unexpected rehearsal size")
    _require(rehearsal["formal_quality_metrics"] is None, "Formal quality metrics are claimed")
    _require(rehearsal["human_scores"] is None, "Human scores are claimed")
    _require(
        all(row.get("private_fields_absent_from_backend_command") is True for row in results),
        "A backend command did not record the private-field boundary",
    )
    _require(
        all(row.get("isolated_from_chat") is True for row in results),
        "A rehearsal item was not isolated from learner chat",
    )
    by_protocol = Counter(row["protocol_id"] for row in results)
    by_status = Counter((row["protocol_id"], row["status"]) for row in results)
    _require(by_protocol == {"sciq_openqa": 2, "sciq_mcq": 2}, "Unexpected protocols")
    _require(by_status[("sciq_openqa", "refused")] == 2, "OpenQA outcomes changed")
    _require(by_status[("sciq_mcq", "completed")] == 2, "MCQ outcomes changed")
    releases = sorted({row["release_id"] for row in results})
    _require(len(releases) == 1, "Rehearsal results reference multiple corpus releases")
    return {
        "status": rehearsal["status"],
        "model_mode": rehearsal["model_mode"],
        "scheduled_count": rehearsal["scheduled_count"],
        "protocol_outcomes": {
            "sciq_openqa": {"refused": by_status[("sciq_openqa", "refused")]},
            "sciq_mcq": {"completed": by_status[("sciq_mcq", "completed")]},
        },
        "corpus_release_id": releases[0],
        "private_fields_absent_from_backend_command": True,
        "isolated_from_chat": True,
        "formal_quality_metrics": None,
        "human_scores": None,
    }


def _qrel_pool(root: Path) -> dict[str, Any]:
    pool = read_json(root / "evidence/retrieval/r0-late-review-pool.json")
    _require(pool["status"] == "prepared_unreviewed", "R0 pool is not an unreviewed pool")
    _require(pool["scheduled_judgements"] == 75, "Unexpected R0 qrel pool size")
    _require(pool["judged_count"] == 0, "R0 qrel pool already contains grades")
    _require(
        pool["all_grades_and_reviewer_fields_null"] is True,
        "R0 qrel pool does not preserve null review fields",
    )
    _require(pool["database_read_only"] is True, "R0 qrel pool was not prepared read-only")
    return {
        "status": pool["status"],
        "version": pool["version"],
        "scheduled_judgements": pool["scheduled_judgements"],
        "judged_count": pool["judged_count"],
        "pool_hash": pool["pool_hash"],
        "source_release_id": pool["corpus_release_id"],
        "active_release_unchanged": pool["active_release_unchanged"],
        "manual_review_remaining": pool["manual_review_remaining"],
        "grade_transfer_allowed": False,
    }


def _chunking_comparison(root: Path) -> dict[str, Any]:
    comparison = read_json(root / "evidence/chunking/fixed-v5/comparison-summary.json")
    _require(comparison["status"] == "passed", "Fixed chunking comparison did not pass")
    _require(comparison["read_only"] is True, "Fixed chunking comparison was not read-only")
    _require(
        comparison["comparison_unactivated"] is True,
        "Fixed chunking comparison unexpectedly changed the active release",
    )
    _require(
        comparison["controlled_factor"] == "chunking strategy only",
        "Comparison changes more than chunking strategy",
    )
    release_counts = comparison["release_counts"]
    return {
        "status": comparison["status"],
        "baseline_release_id": comparison["baseline_release_id"],
        "fixed_release_id": comparison["fixed_release_id"],
        "controlled_factor": comparison["controlled_factor"],
        "comparison_unactivated": comparison["comparison_unactivated"],
        "book_count": len(comparison["books"]),
        "structure_chunks": release_counts.get("structure", release_counts.get("baseline_chunks")),
        "fixed_chunks": release_counts.get("fixed", release_counts.get("fixed_chunks")),
        "human_qrels": comparison["human_qrels"],
    }


def _conversation_fixtures(root: Path) -> dict[str, Any]:
    fixture = read_json(root / "evaluation/conversations/scenarios.json")
    _require(fixture["family_count"] == 12, "Conversation fixture must keep 12 families")
    _require(len(fixture["scenarios"]) == 12, "Conversation fixture scenario count changed")
    return {
        "family_count": fixture["family_count"],
        "scenario_ids": [row["scenario_id"] for row in fixture["scenarios"]],
        "semantic_correctness": None,
    }


def _task_statuses(root: Path) -> dict[str, dict[str, Any]]:
    tasks = _task_map(root)
    wanted = sorted(set(EXPECTED_WEEK7_TASKS) | set(WEEK7_CARRY_FORWARD))
    return {
        task_id: {
            "status": tasks[task_id]["status"],
            "implementation_status": tasks[task_id]["implementation_status"],
            "verification_status": tasks[task_id]["verification_status"],
            "research_status": tasks[task_id]["research_status"],
            "human_review_status": tasks[task_id]["human_review_status"],
            "remaining_scope": tasks[task_id].get("remaining_scope"),
            "evidence": tasks[task_id].get("evidence_paths", tasks[task_id].get("evidence", [])),
        }
        for task_id in wanted
    }


